---
import '../styles/article-list.css';

import { getCollection } from 'astro:content';
import { openGraph } from 'spectre:globals';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import ImageGlow from '../components/ImageGlow.astro';
import Layout from '../layouts/Layout.astro';

const projects = await getCollection('projects', (project) => project.data.draft !== true);
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, '');
function withBase(target: string) { return `${basePath}${target}`; }
---
<Layout
	title={openGraph.projects.title || "Projects"}
	description={openGraph.projects.description}
	pagefindIgnore
>
  <div class="layout-grid-left" slot="left">
    <Card class="flex-col-card">
      <h2 class="no-mt">Stats</h2>
			<div class="stats-div">
				<div class="stat">
					<h3 class="text-glow">{projects.length}</h3>
					<span>Project{projects.length === 1 ? '' : 's'}</span>
				</div>
			</div>
    </Card>
  </div>
  <div class="layout-grid-right" slot="right">
		<Card>
			<div class="header-container">
				<Icon type='lucide' name="folder-git" width={24} height={24} class='glow-icon' />
				<h2>Latest Projects</h2>
			</div>
			<div class="content-container">
				{projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).map((post) => (
					<a href={withBase(`/projects/${post.id}`)} class="post-container project-preview">
						<h3 class="project-title">{post.data.title}</h3>
						<span class="post-date project-date">{post.data.date.toLocaleDateString()}</span>
						<span class="project-desc">{post.data.description}</span>
						{post.data.image && (
							<div class="project-thumb">
								<ImageGlow
									quality={90}
									src={post.data.image}
									alt={`${post.data.title} preview`}
									class="project-thumb-image"
								/>
							</div>
						)}
					</a>
				))}
			</div>
		</Card>
  </div>
</Layout>
<style>
	.stats-div {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.stat {
		display: flex;
		flex-direction: column;
	}

	.stat h3 {
		font-size: 2em;
		margin: 0;
		margin-bottom: .5rem;
	}

</style>

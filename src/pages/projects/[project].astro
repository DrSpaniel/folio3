---
import '../../styles/article.css';

import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import ImageGlow from '../../components/ImageGlow.astro';
import Layout from '../../layouts/Layout.astro';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', (project) => project.data.draft !== true);

	return projects.map((project) => ({ params: { project: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

console.log(project.data.info);

const { Content } = await render(project);
const rawCarousel = project.data.carousel?.length ? project.data.carousel : (project.data.image ? [project.data.image] : []);
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, '');
function withBase(target: string) { return `${basePath}${target}`; }

const extractYouTubeId = (url: string) => {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{6,})/i);
  return match?.[1] ?? null;
};

const youTubeParams = 'enablejsapi=1&playsinline=1&rel=0';
const carouselItems = rawCarousel
  .map((item, index) => {
    if (typeof item === 'object' && 'type' in item && item.type === 'youtube') {
      const id = item.id || (item.url ? extractYouTubeId(item.url) : null);
      if (!id) return null;
      return {
        kind: 'youtube',
        embedUrl: `https://www.youtube-nocookie.com/embed/${id}?${youTubeParams}`,
        title: `${project.data.title} video ${index + 1}`,
      };
    }

    return {
      kind: 'image',
      image: item as ImageMetadata,
      alt: `${project.data.title} image ${index + 1}`,
    };
  })
  .filter((item): item is { kind: 'image'; image: ImageMetadata; alt: string } | { kind: 'youtube'; embedUrl: string; title: string } => item !== null);
---
<Layout
  title={project.data.title}
  description={project.data.description}
  image={project.data.image}
  article={{
    createdAt: project.data.date,
  }}
>
  <div class="left" slot="left">
    <Card class="toc-card">
      <h2 class="no-mt">Info</h2>
      <ul class="overview-list">
        {project.data.info.map((info) => {
          const Tag = info.link ? 'a' : 'div';
          return (
            <li>
              <Tag href={info.link} class='project-info-item'>
                <Icon type={info.icon.type} name={info.icon.name as any} width={24} height={24} class='glow-icon' />
                <span>{info.text}</span>
              </Tag>
            </li>
          )
        })}
      </ul>
    </Card>
  </div>
  <article slot="right" data-pagefind-body>
    <Card>
      <div class="article-header" id="_top" data-pagefind-ignore>
        {carouselItems.length > 0 && (
          <div class="project-carousel" data-interval="7000" data-count={carouselItems.length}>
            {carouselItems.map((item, index) => (
              <div class="carousel-slide" data-kind={item.kind} class:list={{ 'is-active': index === 0 }}>
                {item.kind === 'image' ? (
                  <ImageGlow
                    quality={100}
                    class="article-image"
                    src={item.image}
                    alt={item.alt}
                  />
                ) : (
                  <div class="carousel-video">
                    <iframe
                      id={`yt-${project.id}-${index}`}
                      src={index === 0 ? item.embedUrl : ''}
                      data-embed={item.embedUrl}
                      title={item.title}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    />
                  </div>
                )}
              </div>
            ))}
            <button class="carousel-nav carousel-prev" type="button" aria-label="Previous image">‹</button>
            <button class="carousel-nav carousel-next" type="button" aria-label="Next image">›</button>
            <div class="carousel-dots" role="tablist" aria-label="Image selection">
              {carouselItems.map((_, index) => (
                <button
                  class="carousel-dot"
                  class:list={{ 'is-active': index === 0 }}
                  type="button"
                  aria-label={`Show image ${index + 1}`}
                  data-index={index}
                />
              ))}
            </div>
          </div>
        )}
        <div class="header">
          <div>
            <h1 class="no-mt article-h1">{project.data.title}</h1>
          </div>
          <div class="article-info">
            <span>{project.data.date.toLocaleDateString()}</span>
          </div>
        </div>
      </div>
      <Content />
      <hr class="end-of-article" />
      <a href={withBase('/projects')} class="block-link" data-pagefind-ignore>← Back to projects</a>
    </Card>
  </article>
</Layout>
<div class="lightbox" aria-hidden="true">
	<div class="lightbox-content" role="dialog" aria-modal="true">
		<img class="lightbox-image" alt="" />
	</div>
</div>
<script>
  const carousels = document.querySelectorAll('.project-carousel');
  const lightbox = document.querySelector('.lightbox');
  const lightboxImage = lightbox?.querySelector('.lightbox-image');
  const lightboxImageEl = lightboxImage instanceof HTMLImageElement ? lightboxImage : null;

  const openLightbox = (src: string, alt?: string) => {
    if (!lightbox || !lightboxImageEl) return;
    lightboxImageEl.src = src;
    lightboxImageEl.alt = alt || '';
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('lightbox-open');
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImageEl) return;
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    lightboxImageEl.src = '';
    lightboxImageEl.alt = '';
    document.body.classList.remove('lightbox-open');
  };

  carousels.forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot'));
    const prevButton = carousel.querySelector<HTMLButtonElement>('.carousel-prev');
    const nextButton = carousel.querySelector<HTMLButtonElement>('.carousel-next');
    const images = Array.from(carousel.querySelectorAll<HTMLImageElement>('.carousel-slide[data-kind="image"] .glow-image img:not(.glow)'));
    const intervalMs = Number(carousel.getAttribute('data-interval')) || 7000;
    let currentIndex = 0;
    let timerId: number | undefined;

    const setActive = (nextIndex: number) => {
      currentIndex = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === currentIndex);

        const frame = slide.querySelector<HTMLIFrameElement>('iframe');
        if (!frame) return;

        const embedUrl = frame.getAttribute('data-embed');
        const currentSrc = frame.getAttribute('src');

        if (index === currentIndex) {
          if (embedUrl && currentSrc !== embedUrl) {
            frame.setAttribute('src', embedUrl);
          }
        } else if (currentSrc) {
          frame.setAttribute('src', '');
        }
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle('is-active', index === currentIndex);
      });

      // Stop auto-advance on video slides; resume on image slides
      const activeSlide = slides[currentIndex];
      if (activeSlide?.getAttribute('data-kind') === 'youtube') {
        if (timerId) { window.clearInterval(timerId); timerId = undefined; }
      } else if (!timerId) {
        startTimer();
      }
    };

    const startTimer = () => {
      if (slides.length <= 1) return;
      timerId = window.setInterval(() => setActive(currentIndex + 1), intervalMs);
    };

    const resetTimer = () => {
      if (timerId) window.clearInterval(timerId);
      // Only restart if the current slide is not a video
      const activeSlide = slides[currentIndex];
      if (activeSlide?.getAttribute('data-kind') !== 'youtube') {
        startTimer();
      }
    };

    prevButton?.addEventListener('click', () => {
      setActive(currentIndex - 1);
      resetTimer();
    });

    nextButton?.addEventListener('click', () => {
      setActive(currentIndex + 1);
      resetTimer();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.getAttribute('data-index')) || 0;
        setActive(index);
        resetTimer();
      });
    });

    images.forEach((image) => {
      image.addEventListener('click', (event) => {
        event.preventDefault();
        openLightbox(image.currentSrc || image.src, image.alt);
      });
    });

    setActive(0);
    startTimer();
  });

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  lightbox?.querySelector('.lightbox-content')?.addEventListener('click', (event) => {
    event.stopPropagation();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLightbox();
  });
</script>
<style>
  .project-info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .project-info-item svg {
    flex: 0 0 auto;
  }

  .project-info-item span {
    min-width: 0;
    display: block;
  }
</style>

---
import '../styles/index.css';

import { getCollection, getEntry, render } from 'astro:content';
import { name, openGraph } from 'spectre:globals';
import ProfilePicture from '../assets/image.jpg';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import ImageGlow from '../components/ImageGlow.astro';
import Layout from '../layouts/Layout.astro';

const [posts, projects, about, workExperience, quickInfo, socials] = await Promise.all([
	getCollection('posts', (post) => post.data.draft !== true),
	getCollection('projects'),
	getEntry('other', 'about'),
	getCollection('workExperience'),
	getCollection('quickInfo'),
	getCollection('socials'),
]);

const { Content: About } = await render(about!);
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, '');
function withBase(target: string) { return `${basePath}${target}`; }
---

<Layout
	title={openGraph.home.title || name}
	description={openGraph.home.description}
	pagefindIgnore
>
	<div class="layout-grid-left" slot="left">
		<Card class="flex-col-card">
			<ImageGlow quality={100} width={144} height={144} src={ProfilePicture} alt="Daniel" loading='eager' />
			<h2>{name}</h2>
			<ul class="overview-list">
				{quickInfo.map((info) => (
					<li>
						<Icon type={info.data.icon.type} name={info.data.icon.name as any} width={24} height={24} class='glow-icon' />
						<span>{info.data.text}</span>
					</li>
				))}
			</ul>
		</Card>
		<Card>
			<h3 class="no-mt">Socials</h3>
			<ul class="overview-list">
				{socials.map((item) => (
					<li>
						<a href={item.data.link} class="socials-link">
							<Icon type={item.data.icon.type} name={item.data.icon.name as any} width={30} height={30} class='glow-icon' />
							<span>{item.data.text}</span>
						</a>
					</li>
				))}
			</ul>
		</Card>
	</div>
	<div class="layout-grid-right" slot="right">
		<Card>
			<div class="header-container">
				<Icon type='lucide' name="user" width={24} height={24} class='glow-icon' />
				<h2>About me</h2>
			</div>
			<div class="prose">
				<About />
			</div>
		</Card>
		<Card>
			<div class="header-container">
				<Icon type='lucide' name="folder-git" width={24} height={24} class='glow-icon' />
				<h2><a href={withBase('/projects')} class="section-link">Latest Projects</a></h2>
			</div>
			<div class="content-container">
				{projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2).map((project) => (
					<a href={withBase(`/projects/${project.id}`)} class="post-container project-preview">
						<h3 class="project-title">{project.data.title}</h3>
						<span class="post-date project-date">{project.data.date.toLocaleDateString()}</span>
						<span class="project-desc">{project.data.description}</span>
						{project.data.image && (
							<div class="project-thumb">
								<ImageGlow
									quality={90}
									width={96}
									height={96}
									src={project.data.image}
									alt={`${project.data.title} preview`}
									class="project-thumb-image"
								/>
							</div>
						)}
					</a>
				))}
				<a href={withBase('/projects')} class="post-container see-more">See more...</a>
			</div>
		</Card>
	</div>
</Layout>
